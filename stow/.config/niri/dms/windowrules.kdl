// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1792897669730478381 @name=steam
window-rule {
    match app-id="^steam$"
}

// @id=wr_1793195078050366109 @name=Horizon-client
window-rule {
    match app-id="^Horizon-client$"
}

// @id=wr_1794107580150864934 @name=Steam Games
window-rule {
    match app-id="^steam_app_*"
    open-fullscreen true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
